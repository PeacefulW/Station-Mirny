Thumbs.db

# IDE
.vscode/
*.code-workspace
Godot_v4.6.1-stable_win64.exe
Godot_v4.6.2-stable_win64.exe
Godot_v4.6.2-stable_win64_console.exe
gdextension/godot-cpp/

# GDExtension build artifacts. The two shipped station_mirny*.dll stay tracked;
# everything else here is regenerated by SCons on every build. The .sconsign
# database alone is a 19 MB binary that re-dirties the tree after each compile,
# and the ~-prefixed files are Windows linker/AV lock copies, not build output.
gdextension/.sconsign.dblite
gdextension/src/*.obj
gdextension/bin/*.exp
gdextension/bin/*.lib
gdextension/bin/~*

# Local agent/tooling downloads
.tools/
test-results/gdunit4/
gdextension/compile_commands.json

# Local secrets
.env
.env.*
!.env.example
.gemini/.env
.gemini/.env.*
!.gemini/.env.example

